# Heapdesk side project (only applied when SOLAR_OS_ENABLE_HEAPDESK=1).
CONFIG_HEAPDESK_ENABLED=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_MQTT_PROTOCOL_311=y
# MQTTS/HTTPS: give the system event task, the MQTT task and the connector
# worker enough stack for TLS (sys_evt overflowed at 2304 B on mqtts://).
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_HEAPDESK_TASK_STACK_SIZE=8192
CONFIG_HEAPDESK_MQTT_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
